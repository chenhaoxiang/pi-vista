{
  "name": "@pi-vista/core",
  "version": "0.1.0",
  "description": "Fail-open event emission, redaction, run IDs, and local stores for pi-vista",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./emit": {
      "types": "./dist/emit.d.ts",
      "import": "./dist/emit.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    },
    "./run-id": {
      "types": "./dist/run-id.d.ts",
      "import": "./dist/run-id.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@pi-vista/protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
