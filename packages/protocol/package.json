{
  "name": "@pi-vista/protocol",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript interfaces for pi-vista",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs dist .test.js --allow-empty"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}